# Cella macOS 签名 + 公证配置模板
#
# 复制为 .env 并填入真实值。.env 已被 .gitignore 排除，切勿提交。
#
#   cp .env.example .env
#
# 证书需先存在于 Keychain（钥匙串访问 → 我的证书），可用以下命令确认：
#   security find-identity -v -p codesigning

# 代码签名证书的完整常用名（codesign 的 --sign 参数）
APPLE_SIGNING_IDENTITY="Developer ID Application: Your Name (TEAMID)"

# notarytool 公证凭据
# APPLE_PASSWORD 必须是 App 专用密码，不是 Apple ID 登录密码。
# 生成地址：https://account.apple.com/account/manage → 登录与安全 → App 专用密码
APPLE_ID=you@example.com
APPLE_PASSWORD=xxxx-xxxx-xxxx-xxxx
APPLE_TEAM_ID=XXXXXXXXXX
